		{"id":"ccabfba7112ed9d5","x":120,"y":100,"width":250,"height":60,"type":"text","text":"Веб-сайт"},
		{"id":"1f28a0907b95f6bd","x":-458,"y":300,"width":830,"height":240,"type":"text","text":"База данных:\n"},
		{"id":"d7715c4e3f0c5280","x":-430,"y":350,"width":220,"height":160,"type":"text","text":"Пользователи:\n- логины\n- профили\n- роли"},
		{"id":"a2cb0bb63c4bac72","x":-158,"y":350,"width":230,"height":160,"type":"text","text":"События:\n- турниры\n- тренировки\n- результаты\n"},
		{"id":"f8c450238e6e14ff","x":120,"y":350,"width":220,"height":160,"type":"text","text":"Контент:\n- новости\n- статьи\n- галерея"},
		{"id":"3e3dd86ce0d06dd2","x":-430,"y":630,"width":220,"height":60,"type":"text","text":"Аналитика (Метрика, Google Analytics)"},
		{"id":"b7453af4d34efd21","x":120,"y":630,"width":220,"height":60,"type":"text","text":"Резервные копии"},
